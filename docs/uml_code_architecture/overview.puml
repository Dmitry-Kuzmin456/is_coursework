@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #334155
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam component {
  BackgroundColor white
  BorderColor #334155
}

actor "Пользователь" as User

node "Клиентская сторона" {
  [Frontend\nбраузер, React] as FE
}

node "helios" {
  [Node.js\nстраницы React] as Node
  [Backend\nJakarta EE / WildFly] as BE
  [PostgreSQL] as DB
}

User --> FE : ввод
FE --> User : экраны

FE --> Node : запрос страницы
Node --> FE : HTML, JS, CSS

FE --> BE : JSON-запрос\n(заявки, тендеры, план)
BE --> FE : JSON-ответ

BE --> DB : SQL / PL/pgSQL
DB --> BE : строки данных

@enduml
