  account [group=people]
  contractor [group=people]
  bid [group=people]
  facility [group=place]
  element [group=place]
  project [group=place]
  work [group=place]
  defect [group=place]
  spec [group=skill]
  work_type [group=skill]
  tender [group=skill]

  subgraph layout {
    edge [style=invis weight=8]
    account -> contractor -> bid
    facility -> element -> project -> work -> defect
    spec -> work_type -> tender
    {rank=same; account; facility}
    {rank=same; contractor; element; spec}
    {rank=same; bid; project; work_type}
    {rank=same; work; tender}
  }

  account:bot -> contractor:top [comment="teetee,odottee"]
  account:right -> facility:left [comment="teetee,crowodot"]
  account:botl -> project:left [comment="teetee,crowodot" constraint=false]
  account:botr -> defect:left [comment="odottee,crowodot" constraint=false]

  contractor:right -> spec:left [comment="crowodot,crowodot"]
  contractor:bot -> bid:top [comment="teetee,crowodot" constraint=false]
  contractor:botr -> work:left [comment="odottee,crowodot" constraint=false]

  facility:bot -> element:top [comment="teetee,crowodot"]
  facility:botr -> project:topl [comment="teetee,crowodot" constraint=false]

  element:topr -> element:right [comment="odottee,crowodot" constraint=false]
  element:bot -> project:top [comment="teetee,crowodot"]
  element:botr -> work:topl [comment="teetee,crowodot" constraint=false]
  element:botl -> defect:topl [comment="teetee,crowodot" constraint=false]

  spec:bot -> work_type:top [comment="teetee,crowodot"]
  spec:botr -> tender:top [comment="teetee,crowodot" constraint=false]

  work_type:botl -> work:topr [comment="teetee,crowodot" constraint=false]

  project:bot -> work:top [comment="teetee,crowodot"]
  project:botr -> tender:topl [comment="teetee,crowodot" constraint=false]

  tender:left -> work:right [comment="odottee,crowodot"]
  tender:botl -> bid:right [comment="teetee,crowodot" constraint=false]

  work:botl -> work:botr [comment="crowodot,crowodot" constraint=false]
  work:bot -> defect:top [comment="teetee,crowodot"]
}
